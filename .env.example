# ---------------------------------------------------------------------------
# Noor AI - environment template.
#   Copy-Item .env.example .env
# Every key below also has a code default in backend/app/settings.py, so .env
# only needs the values you actually want to override. Verify the wiring with:
#   .venv\Scripts\python.exe scripts\check_gateway.py
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Model provider - where chat completions come from
# ---------------------------------------------------------------------------
# gateway : route every chat/embedding call through Noor Gateway (default; the
#           real product path). The gateway must be running on
#           NOOR_GATEWAY_BASE_URL - start it with scripts\start_gateway.ps1.
# fake    : deterministic offline stub, no network. Used by the test suites.
# openai  : call OpenAI directly (bypasses the gateway; needs OPENAI_API_KEY).
NOOR_MODEL_PROVIDER=gateway
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Noor Gateway - the infrastructure layer
# (backend/app/model_provider.py, backend/app/intelligence/*, backend/app/admin.py)
# ---------------------------------------------------------------------------
# Base URL of the gateway. Must match GATEWAY_PORT in the gateway repo's .env.
NOOR_GATEWAY_BASE_URL=http://127.0.0.1:8080
# Must equal NOOR_DEV_API_KEY in the gateway repo's .env (dev default shown).
NOOR_GATEWAY_API_KEY=ngw_sk_dev
# Requested model. "noor-auto" lets the gateway pick the real downstream model.
NOOR_GATEWAY_MODEL=noor-auto
# Timeout for gateway chat completions (seconds).
NOOR_GATEWAY_TIMEOUT_SECONDS=45
# The gateway's embed endpoint may block on a one-time model download, so this
# is deliberately generous.
NOOR_GATEWAY_EMBED_TIMEOUT_SECONDS=60

GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------------------------------------------------------------------
# Noor Intelligence Layer (memory, retrieval, token reduction)
# ---------------------------------------------------------------------------
# Master switch. Tests set false so the suite never opens the on-disk Qdrant
# store (keeps tests hermetic and avoids storage locks).
NOOR_INTELLIGENCE_ENABLED=true
# Embedding size - must match the gateway's embedder AND the Qdrant collections
# (all-MiniLM-L6-v2 = 384). Changing this requires recreating the collections.
NOOR_EMBEDDING_DIMENSIONS=384
# Embedded on-disk Qdrant directory (defaults to <repo>/qdrant_data).
# NOOR_QDRANT_PATH=C:\Users\you\Documents\noor ai\qdrant_data
# Approximate blended USD per token, used only for the savings display.
NOOR_COST_PER_TOKEN_USD=0.0000006

# ---------------------------------------------------------------------------
# Session / auth - server-signed identity (backend/app/auth.py)
# ---------------------------------------------------------------------------
# REQUIRED in production. Long random value, e.g. `openssl rand -hex 32`.
# If unset the app mints an ephemeral key at boot (dev only - sessions die on
# restart and it is unsafe across multiple workers).
NOOR_SESSION_SECRET=change_me_openssl_rand_hex_32
# Session lifetime in seconds (default 30 days).
NOOR_SESSION_TTL_SECONDS=2592000
# Cookie name for the session token.
NOOR_SESSION_COOKIE_NAME=noor_session
# Set true only behind HTTPS (required for the Secure cookie flag).
NOOR_SESSION_COOKIE_SECURE=false
# Observe -> enforce rollout. false: valid sessions win, but requests without
# one fall back to the client-supplied user_id (legacy, unchanged). true: the
# client id is ignored and a missing/invalid session is a 401. Flip to true
# once the frontend is issuing sessions (it does, on load + sign-in).
NOOR_AUTH_ENFORCE=false

# ---------------------------------------------------------------------------
# Concurrency + usage limits (backend/app/concurrency.py)
# ---------------------------------------------------------------------------
# Max in-flight chat requests per user (<= 0 disables the limiter).
NOOR_MAX_CONCURRENT_PER_USER=3
# Seconds a request waits for a free slot before returning 429.
NOOR_CONCURRENCY_TIMEOUT_SECONDS=10
# Per-user per-UTC-day message cap (0 = unlimited; set e.g. 200 to enforce).
NOOR_DAILY_MESSAGE_LIMIT=0

# ---------------------------------------------------------------------------
# Admin dashboard access (backend/app/admin.py)
# ---------------------------------------------------------------------------
# Comma-separated allowlists. Identity always comes from the signed session.
NOOR_ADMIN_EMAILS=
NOOR_ADMIN_USER_IDS=
# Let loopback (127.0.0.1 / ::1) reach /api/admin without a session. Convenient
# locally; set false behind a reverse proxy that terminates on localhost.
NOOR_ADMIN_ALLOW_LOOPBACK=true

# ---------------------------------------------------------------------------
# Bring your own key (BYOK) — backend/app/byok.py, byok_api.py, crypto.py
# ---------------------------------------------------------------------------
# Users may store their own Anthropic / OpenAI / DeepSeek / Moonshot key. It is
# tried first for that user's requests only; the gateway stays the default and
# the fallback. Keys are encrypted with AES-256-GCM before they touch the DB.
NOOR_BYOK_ENABLED=true
# Verify the key against the provider before storing it (recommended; costs one
# tiny request). false stores unverified keys.
NOOR_BYOK_VERIFY_ON_SAVE=true
NOOR_BYOK_TIMEOUT_SECONDS=15
NOOR_BYOK_MAX_KEYS_PER_USER=8

# 32-byte key used to encrypt user credentials, base64 or hex.
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Leave empty for local dev: a key is generated into .noor_secret (git-ignored).
# REQUIRED in production — startup fails loudly rather than inventing one.
NOOR_ENCRYPTION_KEY=
# Path of the local secret file used when the key above is empty.
NOOR_SECRET_FILE=.noor_secret

# ---------------------------------------------------------------------------
# Load shaping for ~1000 concurrent users
# ---------------------------------------------------------------------------
# Process-wide cap on in-flight generations (protects the gateway + sockets).
NOOR_MAX_CONCURRENT_GLOBAL=256
# Per-user queue wait before a 429 (seconds).
# Per-user token bucket for chat / auth / key management.
NOOR_RATE_LIMIT_CHAT_PER_MIN=60
NOOR_RATE_LIMIT_CHAT_BURST=10
NOOR_RATE_LIMIT_AUTH_PER_MIN=20
NOOR_RATE_LIMIT_AUTH_BURST=5
NOOR_RATE_LIMIT_BYOK_PER_MIN=20
NOOR_RATE_LIMIT_BYOK_BURST=5
# Reject oversized payloads before they are parsed (bytes) and cap message size.
NOOR_MAX_BODY_BYTES=262144
NOOR_MAX_MESSAGE_CHARS=8000
# Background memory-extraction pool: workers, queue depth, and behaviour when
# saturated (work is dropped and counted, never queued unboundedly).
NOOR_BG_WORKERS=4
NOOR_BG_QUEUE_SIZE=512
# Comma-separated extra CORS origins (production frontend URL).
NOOR_ALLOWED_ORIGINS=
# Set true in production: disables the mock login and enforces strict checks.
NOOR_ENV=development
